<mvc:View controllerName="ZDailySalesMaterialSummaryArjas.controller.View1" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
	xmlns:smartFilterBar="sap.ui.comp.smartfilterbar" xmlns:viz="sap.viz.ui5.controls">
	<ScrollContainer id="mainScroll" width="100%" height="100%" horizontal="true" vertical="true" focusable="true" class="sapUiSizeCompact">
		<VBox class="sapUiSmallMargin">
			<smartFilterBar:SmartFilterBar id="smartFilterBar" entitySet="Zsales_Daily_Update" useToolbar="true" showMessages="true"
				persistencyKey="SmartFilterBarKey" search=".onSearch"/>
			<!-- THIS IS THE MISSING CONTAINER -->
			<VBox id="contentBox" width="100%" class="sapUiSmallMarginTop">
				<!-- Pie Chart stays INSIDE contentBox -->
				<viz:VizFrame id="pieChart" vizType="pie" height="500px" width="100%"/>
			</VBox>
		</VBox>
	</ScrollContainer>
</mvc:View>